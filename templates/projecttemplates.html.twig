{# ProjectPlus — tela "Modelos" (Etapa 4) #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/projectplus.css">

<div class="projectplus-app" id="projectplus-templates">

    {# Bloco N-1a: barra superior no lugar da coluna lateral #}
    {% include '@projectplus/_topbar.html.twig' with {pp_active: 'modelos'} %}

    {# ================= ÁREA PRINCIPAL ================= #}
    {# Bloco N-8b-1: layout do mockup — título com as duas ações, indicadores,
       faixa de busca/Tipo (filtra no cliente) e tabela em caixa. Modais, nomes
       de campo e o form de exclusão são os mesmos de antes. #}
    <div class="projectplus-main pp-tl">

        <div class="pp-cfg-head">
            <h1>{{ __('Modelos de projeto', 'projectplus') }}</h1>
            <span class="pp-cfg-head__sub">{{ __('Crie projetos prontos a partir de uma estrutura de tarefas e subprojetos salva', 'projectplus') }}</span>
            <span class="pp-tp-headbtns">
                <a class="pp-filterbar__btn" href="{{ plugin_web_dir }}/front/projecttemplate_edit.php"><i class="ti ti-plus" aria-hidden="true"></i>{{ __('Criar modelo do zero', 'projectplus') }}</a>
                <button type="button" class="pp-cfg-save" data-pp-modal-open="pp-modal-savetemplate"><i class="ti ti-device-floppy" aria-hidden="true"></i>{{ __('Salvar projeto como modelo', 'projectplus') }}</button>
            </span>
        </div>

        <div class="pp-tl-kpis">
            <div class="pp-tl-kpi"><span class="pp-cfg-card__title">{{ __('Modelos', 'projectplus') }}</span><b>{{ summary.templates }}</b></div>
            <div class="pp-tl-kpi"><span class="pp-cfg-card__title">{{ __('Tarefas nos modelos', 'projectplus') }}</span><b>{{ summary.tasks }}</b></div>
            <div class="pp-tl-kpi"><span class="pp-cfg-card__title">{{ __('Com subprojetos', 'projectplus') }}</span><b>{{ summary.with_subs }}</b></div>
            <div class="pp-tl-kpi"><span class="pp-cfg-card__title">{{ __('Atualizado por último', 'projectplus') }}</span><b class="pp-tl-kpi__txt">{{ summary.last_label ?: '—' }}</b></div>
        </div>

        {% if templates %}
        <div class="pp-tl-filter" data-pp-role="tl-filter"
             data-label-one="{{ _n('%d modelo', '%d modelos', 1, 'projectplus') }}" data-label-many="{{ _n('%d modelo', '%d modelos', 2, 'projectplus') }}">
            <input type="search" class="pp-tp-input pp-tl-search" data-pp-role="tl-search"
                   placeholder="{{ __('Buscar modelo…', 'projectplus') }}" aria-label="{{ __('Buscar modelo…', 'projectplus') }}">
            {% if type_options %}
            <label class="pp-cfg-row__hint" for="pp-tl-type">{{ __('Tipo', 'projectplus') }}</label>
            <select id="pp-tl-type" class="pp-tp-input" data-pp-role="tl-type">
                <option value="">{{ __('Todos os tipos', 'projectplus') }}</option>
                {% for o in type_options %}<option value="{{ o.id }}">{{ o.name }}</option>{% endfor %}
                <option value="0">{{ __('Sem tipo', 'projectplus') }}</option>
            </select>
            {% endif %}
            <span class="pp-filterbar__spacer"></span>
            <span class="pp-cfg-row__hint" data-pp-role="tl-count">{{ _n('%d modelo', '%d modelos', templates|length, 'projectplus')|format(templates|length) }}</span>
        </div>

        <div class="pp-tablewrap">
            <table class="projectplus-table pp-tl-table">
                <thead>
                    <tr>
                        <th>{{ __('Modelo', 'projectplus') }}</th>
                        <th class="pp-tl-th-type">{{ __('Aplica ao projeto', 'projectplus') }}</th>
                        <th class="pp-tl-th-struct">{{ __('Estrutura', 'projectplus') }}</th>
                        <th class="pp-tl-th-date">{{ __('Atualizado em', 'projectplus') }}</th>
                        <th class="pp-actions-cell">{{ __('Ações', 'projectplus') }}</th>
                    </tr>
                </thead>
                <tbody data-pp-role="tl-rows">
                {% for t in templates %}
                    <tr data-pp-name="{{ (t.name ~ ' ' ~ t.comment)|lower }}" data-pp-type="{{ t.type_id }}">
                        <td>
                            <div class="pp-tl-name">{{ t.name }}</div>
                            {% if t.comment %}<div class="pp-tl-comment">{{ t.comment }}</div>{% endif %}
                        </td>
                        <td>
                            {% if t.type_id %}<span class="pp-typetag" style="--pp-type-color: {{ t.type_color }}">{{ t.type_name }}</span>
                            {% else %}<span class="pp-rp-none">{{ __('Sem tipo', 'projectplus') }}</span>{% endif %}
                        </td>
                        <td>
                            <span class="pp-tl-chips">
                                <span class="pp-tl-chip">{{ _n('%d tarefa', '%d tarefas', t.count, 'projectplus')|format(t.count) }}</span>
                                {% if t.subcount > 0 %}<span class="pp-tl-chip">{{ _n('%d subprojeto', '%d subprojetos', t.subcount, 'projectplus')|format(t.subcount) }}</span>{% endif %}
                            </span>
                        </td>
                        <td class="pp-muted-cell">{{ t.date_label }}</td>
                        <td class="pp-actions-cell">
                            <span class="pp-tl-actions">
                            {% if can_create %}
                            <button type="button" class="pp-cfg-save pp-tl-btn pp-tpl-instantiate-btn"
                                    data-pp-modal-open="pp-modal-instantiate"
                                    data-tpl-id="{{ t.id }}" data-tpl-name="{{ t.name }}">{{ __('Criar projeto', 'projectplus') }}</button>
                            {% endif %}
                            <a class="pp-filterbar__btn pp-tl-btn" href="{{ plugin_web_dir }}/front/projecttemplate_edit.php?id={{ t.id }}">{{ __('Editar', 'projectplus') }}</a>
                            <form method="post" action="{{ plugin_web_dir }}/front/projecttemplate.form.php" class="pp-tl-del"
                                  data-pp-confirm="{{ __('Excluir este modelo?', 'projectplus') }}">
                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                                <input type="hidden" name="id" value="{{ t.id }}">
                                <button type="submit" name="delete" value="1" class="pp-filterbar__btn pp-tp-ib pp-tl-delbtn"
                                        title="{{ __('Excluir', 'projectplus') }}" aria-label="{{ __('Excluir', 'projectplus') }}: {{ t.name }}"><i class="ti ti-trash" aria-hidden="true"></i></button>
                            </form>
                            </span>
                        </td>
                    </tr>
                {% endfor %}
                    <tr data-pp-role="tl-empty" hidden><td colspan="5" class="pp-rp-none">{{ __('Nenhum modelo com esse filtro.', 'projectplus') }}</td></tr>
                </tbody>
            </table>
        </div>
        {% else %}
            <p class="pp-rp-empty">
                {{ __('Nenhum modelo cadastrado ainda.', 'projectplus') }}
                {{ __('Use "Criar modelo do zero" ou "Salvar projeto como modelo" para criar o primeiro.', 'projectplus') }}
            </p>
        {% endif %}
    </div>
</div>

{# ================= MODAL: SALVAR PROJETO COMO MODELO ================= #}
<div class="projectplus-modal" id="pp-modal-savetemplate" hidden>
    <div class="projectplus-modal__backdrop" data-pp-modal-close></div>
    <div class="projectplus-modal__box">
        <div class="projectplus-modal__head">
            <h3>{{ __('Salvar projeto como modelo', 'projectplus') }}</h3>
            <button type="button" class="projectplus-modal__x" data-pp-modal-close>&times;</button>
        </div>
        <form method="post" action="{{ plugin_web_dir }}/front/projecttemplate.form.php" class="projectplus-form">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

            <label class="projectplus-form__full">
                {{ __('Projeto de origem', 'projectplus') }} *
                <select name="projects_id" required>
                    <option value="">{{ __('— Selecione —', 'projectplus') }}</option>
                    {% for p in projects %}
                        <option value="{{ p.id }}">{{ p.name }}</option>
                    {% endfor %}
                </select>
            </label>

            <label class="projectplus-form__full">
                {{ __('Nome do modelo', 'projectplus') }} *
                <input type="text" name="name" required maxlength="255" autofocus>
            </label>

            <label class="projectplus-form__full">
                {{ _n('Comentário', 'Comentários', 1, 'projectplus') }}
                <textarea name="comment" rows="2"></textarea>
            </label>

            <p class="projectplus-muted projectplus-form__full" style="margin:0">
                {{ __('A árvore completa do projeto (tarefas e TODOS os subprojetos, com prazos relativos ao início do projeto) é copiada para o modelo. O projeto de origem não é alterado.', 'projectplus') }}
            </p>

            <div class="projectplus-form__footer">
                <button type="button" class="projectplus-btn projectplus-btn--ghost" data-pp-modal-close>
                    {{ __('Cancelar', 'projectplus') }}
                </button>
                <button type="submit" name="save" value="1" class="projectplus-btn">
                    {{ __('Salvar modelo', 'projectplus') }}
                </button>
            </div>
        </form>
    </div>
</div>

{# ================= MODAL: CRIAR PROJETO A PARTIR DO MODELO ================= #}
{% if can_create %}
<div class="projectplus-modal" id="pp-modal-instantiate" hidden>
    <div class="projectplus-modal__backdrop" data-pp-modal-close></div>
    <div class="projectplus-modal__box">
        <div class="projectplus-modal__head">
            <h3>{{ __('Criar projeto a partir do modelo', 'projectplus') }}</h3>
            <button type="button" class="projectplus-modal__x" data-pp-modal-close>&times;</button>
        </div>
        <form method="post" action="{{ plugin_web_dir }}/front/projecttemplate.form.php" class="projectplus-form">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="template_id" id="pp-inst-template-id" value="">

            <p class="projectplus-form__full" style="margin:0">
                {{ __('Modelo', 'projectplus') }}: <strong id="pp-inst-template-name">—</strong>
            </p>

            <label class="projectplus-form__full">
                {{ __('Nome do novo projeto', 'projectplus') }} *
                <input type="text" name="name" required maxlength="255">
            </label>

            <label>
                {{ __('Data de início', 'projectplus') }} *
                <input type="date" name="start_date" required value="{{ "now"|date('Y-m-d') }}">
            </label>

            <p class="projectplus-muted projectplus-form__full" style="margin:0">
                {{ __('Cria o projeto, todas as tarefas e todos os subprojetos do modelo, com as datas deslocadas a partir da data escolhida.', 'projectplus') }}
            </p>

            <div class="projectplus-form__footer">
                <button type="button" class="projectplus-btn projectplus-btn--ghost" data-pp-modal-close>
                    {{ __('Cancelar', 'projectplus') }}
                </button>
                <button type="submit" name="instantiate" value="1" class="projectplus-btn">
                    {{ __('Criar projeto', 'projectplus') }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endif %}

<script src="{{ plugin_web_dir }}/js/projectplus.js"></script>
<script>
    // Espera o DOMContentLoaded: os JS do hook do GLPI (i18n.js à frente)
    // executam ANTES desse evento, então o primeiro desenho já sai com o
    // dicionário de tradução carregado (correção de 31/07/2026).
    (function () {
        function ppBoot() {
            if (window.ProjectPlus && typeof window.ProjectPlus.initTemplates === 'function') {
                window.ProjectPlus.initTemplates();
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', ppBoot);
        } else {
            ppBoot();
        }
    })();
</script>

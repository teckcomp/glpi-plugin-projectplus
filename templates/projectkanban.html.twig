{# ProjectPlus — "Kanban de projetos" (Etapa 8, Bloco 4): colunas por fase, cartões = projetos/subprojetos, somente leitura #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/projectplus.css">

<div class="projectplus-app" id="projectplus-projectkanban">

    {# ================= COLUNA ESQUERDA: título + sidebar ================= #}
    <div class="projectplus-left">
        <div class="projectplus-pagetitle">
            <div class="projectplus-brand">
                <img class="projectplus-brand__mark" alt=""
                     src="{{ plugin_web_dir }}/img/projectplus-mark.svg">
                <h2>{{ __('Projetos', 'projectplus') }}</h2>
            </div>
            <span>{{ __('Kanban de projetos por fase', 'projectplus') }}</span>
        </div>
        <nav class="projectplus-sidebar">
                        <ul>
                {% if nav.dashboard %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/dashboard.php"><i class="ti ti-layout-dashboard"></i>{{ __('Visão geral', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.tasks %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/mytasks.php"><i class="ti ti-user-check"></i>{{ __('Minhas tarefas', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.kanban %}
                <li class="projectplus-sidebar__item projectplus-sidebar__item--active">
                    <a href="{{ plugin_web_dir }}/front/projectkanban.php"><i class="ti ti-layout-kanban"></i>{{ __('Kanban', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.timeline %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/timeline.php"><i class="ti ti-stopwatch"></i>{{ __('Timeline', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.templates %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/projecttemplates.php"><i class="ti ti-clipboard-list"></i>{{ __('Modelos', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.costs %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/costs.php"><i class="ti ti-coin"></i>{{ __('Orçamento', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.reports %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/reports.php"><i class="ti ti-report-analytics"></i>{{ __('Relatórios', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.config %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/config.form.php"><i class="ti ti-settings"></i>{{ __('Configurações', 'projectplus') }}</a>
                </li>
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/typephases.php"><i class="ti ti-columns-3"></i>{{ __('Fases por tipo', 'projectplus') }}</a>
                </li>
                {% endif %}
            </ul>
        </nav>
    </div>

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="projectplus-main" id="pp-pkb-widget"
         data-ajax-url="{{ plugin_web_dir }}/ajax/project.php"
         data-csrf="{{ csrf_token }}"
         data-can-edit="{{ can_edit ? '1' : '0' }}">

        <div class="projectplus-header">
            <div class="pp-kb-controls">
                <form method="get" class="pp-type-pick" action="{{ plugin_web_dir }}/front/projectkanban.php">
                    {% if type_scope %}<input type="hidden" name="scope" value="{{ type_scope }}">{% endif %}
                    <label>
                        <i class="ti ti-category"></i>{{ __('Tipo', 'projectplus') }}
                        <select name="type" onchange="this.form.submit()"
                                title="{{ __('As colunas são as fases do tipo de projeto escolhido', 'projectplus') }}">
                            {% if type_union %}
                            <option value="all" {{ type_selected is null ? 'selected' : '' }}>{{ __('Todos os tipos', 'projectplus') }}</option>
                            {% endif %}
                            {% for t in type_options %}
                            <option value="{{ t.id }}" {{ (type_selected is not null and type_selected == t.id) ? 'selected' : '' }}>{{ t.name }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <noscript>
                        <button type="submit" class="projectplus-btn projectplus-btn--ghost">{{ __('Abrir', 'projectplus') }}</button>
                    </noscript>
                </form>
                <label class="pp-mt-toggle">
                    <input type="checkbox" data-pp-role="done">
                    {{ __('Mostrar projetos concluídos', 'projectplus') }}
                </label>
            </div>
            <div class="projectplus-actions">
                <input type="search" class="pp-tablesearch" data-pp-role="search"
                       placeholder="{{ __('Buscar projeto…', 'projectplus') }}"
                       aria-label="{{ __('Buscar projeto', 'projectplus') }}">
                {% if scope_can_expand %}
                <a class="projectplus-btn projectplus-btn--ghost pp-scope-toggle" href="{{ scope_toggle_url }}"
                   title="{{ scope_is_expanded ? __('Voltar ao escopo pessoal', 'projectplus') : __('Incluir todos os projetos que você pode ver', 'projectplus') }}">
                    {% if scope_is_expanded %}
                    <i class="ti ti-user"></i>{{ __('Ver só os meus', 'projectplus') }}
                    {% else %}
                    <i class="ti ti-eye"></i>{{ __('Ver tudo', 'projectplus') }}
                    {% endif %}
                </a>
                {% endif %}
                {% if can_task_kanban %}
                <a class="projectplus-btn projectplus-btn--ghost" href="{{ plugin_web_dir }}/front/kanban.php">
                    {{ __('Kanban de tarefas', 'projectplus') }}
                </a>
                {% endif %}
                {% if nav.dashboard %}
                <a class="projectplus-btn projectplus-btn--ghost" href="{{ plugin_web_dir }}/front/dashboard.php">
                    {{ __('Visão geral', 'projectplus') }}
                </a>
                {% endif %}
            </div>
        </div>

        <div class="projectplus-card projectplus-card--full pp-kb-card">
            <p class="projectplus-muted" style="padding: 0 16px 8px; margin: 0;">
                <i class="ti ti-info-circle"></i>
                {% if can_edit %}
                {{ __('Arraste um cartão entre as colunas para mudar a fase do projeto. Projeto com tarefa ou subprojeto aberto não vai para fase finalizada.', 'projectplus') }}
                {% else %}
                {{ __('Somente leitura — cada cartão é um projeto ou subprojeto na coluna da fase atual.', 'projectplus') }}
                {% endif %}
            </p>
            <div class="pp-kb-scroll" data-role="board">
                <p class="projectplus-muted">{{ __('Carregando o Kanban…', 'projectplus') }}</p>
            </div>
        </div>
    </div>
</div>

{# Lição 12: o JSON é montado no PHP com JSON_HEX_TAG|HEX_AMP|HEX_APOS|HEX_QUOT
   (nome de projeto com "</script>" não pode quebrar a página). #}
<script id="pp-pkb-data" type="application/json">{{ board_json|raw }}</script>

<script src="{{ plugin_web_dir }}/js/projectkanban.js"></script>
<script>
    // Espera o DOMContentLoaded: os JS do hook do GLPI (i18n.js à frente)
    // executam ANTES desse evento, então o primeiro desenho já sai com o
    // dicionário de tradução carregado (correção de 31/07/2026).
    (function () {
        function ppBoot() {
            if (window.ProjectPlusProjectKanban && typeof window.ProjectPlusProjectKanban.init === 'function') {
                window.ProjectPlusProjectKanban.init();
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', ppBoot);
        } else {
            ppBoot();
        }
    })();
</script>

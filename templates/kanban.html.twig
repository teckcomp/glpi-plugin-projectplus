{# ProjectPlus — "Kanban" (Etapa 7, Bloco 1): board próprio, colunas por fase, swimlanes alternáveis #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/projectplus.css">

<div class="projectplus-app" id="projectplus-kanban">

    {# Bloco N-1a: barra superior no lugar da coluna lateral. Bloco N-5: sem pp_title — o
       título (com o seletor Tarefas | Projetos) mora DENTRO do widget, para ir junto na tela cheia. #}
    {% include '@projectplus/_topbar.html.twig' with {pp_active: 'kanban'} %}

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="projectplus-main" id="pp-kb-widget"
         data-ajax-url="{{ plugin_web_dir }}/ajax/task.php"
         data-csrf="{{ csrf_token }}"
         data-can-edit="{{ can_edit ? '1' : '0' }}">

        {# Bloco I: tela cheia guardada na aba — marca o modo DURANTE o parse (antes do JS do
           fim da página), senão o GLPI aparece por um instante por baixo. #}
        <script>(function(s){try{if(window.sessionStorage.getItem('pp-kb-fs')==='1'){document.documentElement.classList.add('pp-kb-fs-page');s.parentNode.classList.add('pp-kb-fs');}}catch(e){}})(document.currentScript);</script>

        {# ===== Bloco N-5: título + seletor Tarefas | Projetos (no lugar do botão "Kanban de projetos") ===== #}
        <div class="pp-pagehead pp-kb-head">
            <h1>{{ __('Kanban', 'projectplus') }}</h1>
            <span>
                {% if can_edit %}
                {{ __('Arraste um cartão entre as colunas para mudar a fase da tarefa.', 'projectplus') }}
                {% else %}
                {{ __('Somente leitura — você não tem permissão para alterar tarefas.', 'projectplus') }}
                {% endif %}
            </span>
            {% if can_project_kanban %}
            <div class="pp-seg pp-seg--links pp-kb-boards" role="group" aria-label="{{ __('Kanban', 'projectplus') }}">
                <span class="pp-seg__btn pp-seg__btn--active" aria-current="true">{{ __('Tarefas', 'projectplus') }}</span>
                <a class="pp-seg__btn" href="{{ plugin_web_dir }}/front/projectkanban.php"
                   title="{{ __('Board com os PROJETOS nas colunas de fase', 'projectplus') }}">{{ __('Projetos', 'projectplus') }}</a>
            </div>
            {% endif %}
        </div>

        {# ===== Bloco N-5: faixa de filtros no padrão. Mesmos data-pp-role / classes que o
           kanban.js e o favorite.js leem (pp-kb-seg, data-pp-lane, data-pp-fav-ui). ===== #}
        <div class="pp-filterbar pp-kb-filterbar">
            {% include '@projectplus/_favorite.html.twig' %}
            <span class="pp-filterbar__sep"></span>
            {# Bloco F-2a: escondido na Visão do cliente #}
            {% if not nav.client %}
            <form method="get" class="pp-filterbar__form" action="{{ plugin_web_dir }}/front/kanban.php">
                {% if type_scope %}<input type="hidden" name="scope" value="{{ type_scope }}">{% endif %}
                <span class="pp-filterbar__label">{{ __('Tipo', 'projectplus') }}</span>
                <select name="type" onchange="this.form.submit()"
                        title="{{ __('As colunas são as fases do tipo de projeto escolhido', 'projectplus') }}">
                    {% if type_union %}
                    <option value="all" {{ type_selected is null ? 'selected' : '' }}>{{ __('Todos os tipos', 'projectplus') }}</option>
                    {% endif %}
                    {% for t in type_options %}
                    <option value="{{ t.id }}" {{ (type_selected is not null and type_selected == t.id) ? 'selected' : '' }}>{{ t.name }}</option>
                    {% endfor %}
                </select>
                <noscript>
                    <button type="submit" class="projectplus-btn projectplus-btn--ghost">{{ __('Abrir', 'projectplus') }}</button>
                </noscript>
            </form>
            {% endif %}
            <span class="pp-filterbar__label">{{ __('Raias', 'projectplus') }}</span>
            <div class="pp-seg pp-seg--links pp-kb-seg" role="group" aria-label="{{ __('Agrupar por', 'projectplus') }}" data-pp-fav-ui="lane">
                <button type="button" class="pp-seg__btn{{ fav_lane != 'responsible' ? ' pp-seg__btn--active' : '' }}" data-pp-lane="project">{{ __('Projeto', 'projectplus') }}</button>
                <button type="button" class="pp-seg__btn{{ fav_lane == 'responsible' ? ' pp-seg__btn--active' : '' }}" data-pp-lane="responsible">{{ __('Responsável', 'projectplus') }}</button>
            </div>
            {% if scope_can_expand and not nav.client %}
            <div class="pp-seg pp-seg--links" role="group" aria-label="{{ __('Escopo', 'projectplus') }}">
                {% if scope_is_expanded %}
                <span class="pp-seg__btn pp-seg__btn--active" aria-current="true">{{ __('Todos', 'projectplus') }}</span>
                <a class="pp-seg__btn" href="{{ scope_toggle_url }}" title="{{ __('Voltar ao escopo pessoal', 'projectplus') }}">{{ __('Só os meus', 'projectplus') }}</a>
                {% else %}
                <a class="pp-seg__btn" href="{{ scope_toggle_url }}" title="{{ __('Incluir todos os projetos que você pode ver', 'projectplus') }}">{{ __('Todos', 'projectplus') }}</a>
                <span class="pp-seg__btn pp-seg__btn--active" aria-current="true">{{ __('Só os meus', 'projectplus') }}</span>
                {% endif %}
            </div>
            {% endif %}
            <span class="pp-filterbar__spacer"></span>
            <input type="search" class="pp-filterbar__search" data-pp-role="search"
                   placeholder="{{ __('Buscar tarefa ou projeto…', 'projectplus') }}"
                   aria-label="{{ __('Buscar tarefa ou projeto', 'projectplus') }}">
            <label class="pp-switch">
                <input type="checkbox" data-pp-role="done" data-pp-fav-ui="done"{{ fav_done ? ' checked' : '' }}>
                <span class="pp-switch__track" aria-hidden="true"></span>
                {{ __('Mostrar tarefas concluídas', 'projectplus') }}
            </label>
            <button type="button" class="pp-filterbar__btn pp-kb-fsbtn" data-pp-role="fullscreen"
                    data-label-on="{{ __('Sair da tela cheia', 'projectplus') }}"
                    data-label-off="{{ __('Tela cheia', 'projectplus') }}"
                    title="{{ __('Mostrar o quadro em tela cheia, por cima do menu do GLPI', 'projectplus') }}">
                <i class="ti ti-maximize"></i><span>{{ __('Tela cheia', 'projectplus') }}</span>
            </button>
        </div>

        <div class="pp-kb-card">
            <div class="pp-kb-scroll" data-role="board">
                <p class="projectplus-muted">{{ __('Carregando o Kanban…', 'projectplus') }}</p>
            </div>
        </div>
    </div>
</div>

<script id="pp-kb-data" type="application/json">{{ kanban|json_encode|raw }}</script>

<script src="{{ plugin_web_dir }}/js/kanban.js"></script>
<script>
    // Espera o DOMContentLoaded: os JS do hook do GLPI (i18n.js à frente)
    // executam ANTES desse evento, então o primeiro desenho já sai com o
    // dicionário de tradução carregado (correção de 31/07/2026).
    (function () {
        function ppBoot() {
            if (window.ProjectPlusKanban && typeof window.ProjectPlusKanban.init === 'function') {
                window.ProjectPlusKanban.init();
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', ppBoot);
        } else {
            ppBoot();
        }
    })();
</script>

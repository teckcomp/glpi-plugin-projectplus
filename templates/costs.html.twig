{# ProjectPlus — relatório de custos consolidados (Bloco 5.1) #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/projectplus.css">

<div class="projectplus-app" id="projectplus-costs">

    {# Bloco N-1a: barra superior no lugar da coluna lateral #}
    {% include '@projectplus/_topbar.html.twig' with {pp_active: 'orcamento'} %}

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="projectplus-main">

        <div class="projectplus-header projectplus-noprint">
            <form method="get" class="projectplus-period" action="">
                <select name="project" onchange="this.form.submit()">
                    <option value="0">{{ __('— Todos os projetos —', 'projectplus') }}</option>
                    {% for p in projects_list %}
                        <option value="{{ p.id }}" {{ p.id == filter_project ? 'selected' : '' }}>{{ p.name }}</option>
                    {% endfor %}
                </select>
                {# Escopo (Bloco 4): preserva o modo atual ao trocar o projeto #}
                {% if filter_scope %}<input type="hidden" name="scope" value="{{ filter_scope }}">{% endif %}
                <noscript><button type="submit" class="projectplus-btn projectplus-btn--ghost">{{ __('Aplicar', 'projectplus') }}</button></noscript>
            </form>
            <div class="projectplus-actions">
                {% include '@projectplus/_favorite.html.twig' %}
                {% if scope_can_expand %}
                <a class="projectplus-btn projectplus-btn--ghost pp-scope-toggle" href="{{ scope_toggle_url }}"
                   title="{{ scope_is_expanded ? __('Voltar ao escopo pessoal', 'projectplus') : __('Incluir todos os projetos que você pode ver', 'projectplus') }}">
                    {% if scope_is_expanded %}
                    <i class="ti ti-user"></i>{{ __('Ver só os meus', 'projectplus') }}
                    {% else %}
                    <i class="ti ti-eye"></i>{{ __('Ver tudo', 'projectplus') }}
                    {% endif %}
                </a>
                {% endif %}
                <button type="button" class="projectplus-btn projectplus-btn--ghost" onclick="window.print()">
                    {{ __('Imprimir', 'projectplus') }}
                </button>
            </div>
        </div>

        <div class="pp-report-title">
            <h2>{{ __('Relatório de custos consolidados', 'projectplus') }}</h2>
            <span class="projectplus-muted">{{ __('Gerado em', 'projectplus') }} {{ generated_at }}</span>
        </div>

        {% for proj in report %}
        <div class="projectplus-card pp-report-card">
            <div class="pp-report-projhead">
                <h3>{{ proj.name }}</h3>
                <div class="pp-costsum">
                    <span>{{ __('Consumido', 'projectplus') }}: <strong>{{ proj.total_fmt }}</strong></span>
                    {% if proj.has_ceiling %}
                        <span>{{ __('Teto', 'projectplus') }}: <strong>{{ proj.planned_fmt }}</strong></span>
                        <span>{{ __('Saldo', 'projectplus') }}:
                            <strong class="pp-costsum--{{ proj.state }}">{{ proj.balance_fmt }}</strong></span>
                        <span class="projectplus-badge projectplus-badge--{{ proj.state == 'over' ? 'overdue' : (proj.state == 'warn' ? 'stalled' : 'ok') }}">{{ proj.percent }}%</span>
                    {% else %}
                        <span class="projectplus-muted">{{ __('Sem teto de orçamento definido', 'projectplus') }}</span>
                    {% endif %}
                </div>
            </div>

            {% if proj.entries %}
            <table class="projectplus-table pp-report-table">
                <thead>
                    <tr>
                        <th>{{ __('Origem', 'projectplus') }}</th>
                        <th>{{ __('Descrição', 'projectplus') }}</th>
                        <th>{{ __('Data', 'projectplus') }}</th>
                        <th class="pp-report-num">{{ __('Valor', 'projectplus') }}</th>
                        <th>{{ __('Lançado por', 'projectplus') }}</th>
                        <th>{{ _n('Comentário', 'Comentários', 1, 'projectplus') }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for e in proj.entries %}
                    <tr>
                        <td class="pp-report-origin">{{ e.origin }}</td>
                        <td>{{ e.name }}</td>
                        <td>{{ e.date_fmt }}</td>
                        <td class="pp-report-num">{{ e.cost_fmt }}</td>
                        <td>{{ e.author ?: '—' }}</td>
                        <td class="projectplus-muted">{{ e.comment }}</td>
                    </tr>
                {% endfor %}
                </tbody>
                <tfoot>
                    <tr class="pp-report-total">
                        <td colspan="3"><strong>{{ __('Total consumido', 'projectplus') }}</strong></td>
                        <td class="pp-report-num"><strong>{{ proj.total_fmt }}</strong></td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
            {% else %}
                <p class="projectplus-muted">{{ __('Nenhum lançamento de custo neste projeto', 'projectplus') }}</p>
            {% endif %}
        </div>
        {% else %}
            <div class="projectplus-card"><p class="projectplus-muted">{{ __('Nenhum projeto encontrado', 'projectplus') }}</p></div>
        {% endfor %}
    </div>
</div>

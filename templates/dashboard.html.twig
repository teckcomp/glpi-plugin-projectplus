{# ProjectPlus — Visão Geral no padrão do esboço (Etapa 3, Bloco 3.2) #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/projectplus.css">

<div class="projectplus-app" id="projectplus-dashboard"
     data-ajax-url="{{ plugin_web_dir }}/ajax/dashboard_data.php"
     data-task-url="{{ plugin_web_dir }}/ajax/task.php"
     data-comment-url="{{ plugin_web_dir }}/ajax/comment.php"
     data-dep-url="{{ plugin_web_dir }}/ajax/taskdep.php"
     data-alerts-url="{{ plugin_web_dir }}/ajax/alerts.php"
     data-csrf="{{ csrf_token }}"
     {# Bloco 4: o JS monta as linhas de subprojeto/tarefa no cliente e
        precisa saber quais colunas existem nesta tela. #}
     data-pp-costs="{{ can_costs ? '1' : '0' }}"
     data-pp-tasks="{{ can_tasks ? '1' : '0' }}">

    {# ================= COLUNA ESQUERDA: título + sidebar ================= #}
    <div class="projectplus-left">
        <div class="projectplus-pagetitle">
            <h2>{{ __('Projetos', 'projectplus') }}</h2>
            <span>{{ __('Visão geral dos projetos e seu andamento', 'projectplus') }}</span>
        </div>
        <nav class="projectplus-sidebar">
                        <ul>
                {% if nav.dashboard %}
                <li class="projectplus-sidebar__item projectplus-sidebar__item--active">
                    <a href="#overview"><i class="ti ti-layout-dashboard"></i>{{ __('Visão geral', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.tasks %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/mytasks.php"><i class="ti ti-user-check"></i>{{ __('Minhas tarefas', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.kanban %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/kanban.php"><i class="ti ti-layout-kanban"></i>{{ __('Kanban', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.timeline %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/timeline.php"><i class="ti ti-stopwatch"></i>{{ __('Timeline', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.templates %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/projecttemplates.php"><i class="ti ti-clipboard-list"></i>{{ __('Modelos', 'projectplus') }}</a>
                </li>
                {% endif %}
                <li class="projectplus-sidebar__item projectplus-sidebar__item--soon">
                    <span><i class="ti ti-calendar"></i>{{ __('Calendário', 'projectplus') }}</span><em>{{ __('em breve', 'projectplus') }}</em>
                </li>
                <li class="projectplus-sidebar__item projectplus-sidebar__item--soon">
                    <span><i class="ti ti-users"></i>{{ __('Recursos', 'projectplus') }}</span><em>{{ __('em breve', 'projectplus') }}</em>
                </li>
                {% if nav.costs %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/costs.php"><i class="ti ti-coin"></i>{{ __('Orçamento', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.reports %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/reports.php"><i class="ti ti-report-analytics"></i>{{ __('Relatórios', 'projectplus') }}</a>
                </li>
                {% endif %}
                {% if nav.config %}
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/config.form.php"><i class="ti ti-settings"></i>{{ __('Configurações', 'projectplus') }}</a>
                </li>
                {% endif %}
            </ul>
        </nav>
    </div>

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="projectplus-main">

        {# Cabeçalho: filtro de período + ações #}
        <div class="projectplus-header" id="overview">
            <form method="get" class="projectplus-period" action="">
                <input type="date" name="from" value="{{ filter_from }}" title="{{ __('Início do período', 'projectplus') }}">
                <span>—</span>
                <input type="date" name="until" value="{{ filter_until }}" title="{{ __('Fim do período', 'projectplus') }}">
                <button type="submit" class="projectplus-btn projectplus-btn--ghost">{{ __('Aplicar', 'projectplus') }}</button>
                {% if filter_from or filter_until %}
                    <a href="?" class="projectplus-period__clear" title="{{ __('Limpar filtro', 'projectplus') }}">&times;</a>
                {% endif %}
            </form>
            <div class="projectplus-actions">
                {% if scope_can_expand %}
                <a class="projectplus-btn projectplus-btn--ghost pp-scope-toggle" href="{{ scope_toggle_url }}"
                   title="{{ scope_is_expanded ? __('Voltar ao escopo pessoal', 'projectplus') : __('Incluir todos os projetos que você pode ver', 'projectplus') }}">
                    {% if scope_is_expanded %}
                    <i class="ti ti-user"></i>{{ __('Ver só os meus', 'projectplus') }}
                    {% else %}
                    <i class="ti ti-eye"></i>{{ __('Ver tudo', 'projectplus') }}
                    {% endif %}
                </a>
                {% endif %}
                {% if nav.alerts %}
                <div class="pp-bell-wrap">
                    <button type="button" id="pp-bell" class="pp-bell" title="{{ __('Alertas', 'projectplus') }}">
                        <i class="ti ti-bell"></i><span class="pp-bell__badge" hidden>0</span>
                    </button>
                    <div id="pp-bell-panel" class="pp-bell__panel" hidden>
                        <div class="pp-bell__head">
                            <strong>{{ __('Alertas', 'projectplus') }}</strong>
                            <button type="button" class="pp-bell__readall">{{ __('Marcar todas como lidas', 'projectplus') }}</button>
                        </div>
                        <ul class="pp-bell__list"></ul>
                    </div>
                </div>
                {% endif %}
                {% if can_create %}
                <button type="button" class="projectplus-btn" data-pp-modal-open="pp-modal-newproject">
                    + {{ __('Novo projeto', 'projectplus') }}
                </button>
                {% endif %}
                <a class="projectplus-btn projectplus-btn--ghost" href="{{ glpi_root }}/front/project.php">
                    {{ __('Lista nativa', 'projectplus') }}
                </a>
            </div>
        </div>

        {# ================= 6 KPIs (Etapa 3, Bloco 4 — nova ordem) ================= #}
        <div class="projectplus-kpis">
            <div class="projectplus-kpi">
                <span class="projectplus-kpi__icon projectplus-kpi__icon--blue"><i class="ti ti-briefcase"></i></span>
                <div>
                    <span class="projectplus-kpi__value">{{ kpis.active }}</span>
                    <span class="projectplus-kpi__label">{{ __('Projetos', 'projectplus') }}</span>
                    <span class="projectplus-kpi__sub">{{ __('Ativos', 'projectplus') }}</span>
                </div>
            </div>
            <div class="projectplus-kpi">
                <span class="projectplus-kpi__icon projectplus-kpi__icon--teal"><i class="ti ti-alert-circle"></i></span>
                <div>
                    <span class="projectplus-kpi__value">{{ kpis.overdue }}</span>
                    <span class="projectplus-kpi__label">{{ __('Projetos em atraso', 'projectplus') }}</span>
                    <span class="projectplus-kpi__sub">{{ __('Em risco', 'projectplus') }}</span>
                </div>
            </div>
            {% if can_tasks %}
            <div class="projectplus-kpi">
                <span class="projectplus-kpi__icon projectplus-kpi__icon--amber"><i class="ti ti-file-text"></i></span>
                <div>
                    <span class="projectplus-kpi__value">{{ kpis.open_tasks }}</span>
                    <span class="projectplus-kpi__label">{{ __('Tarefas', 'projectplus') }}</span>
                    <span class="projectplus-kpi__sub">{{ __('Em andamento', 'projectplus') }}</span>
                </div>
            </div>
            <div class="projectplus-kpi">
                <span class="projectplus-kpi__icon projectplus-kpi__icon--red"><i class="ti ti-alert-triangle"></i></span>
                <div>
                    <span class="projectplus-kpi__value">{{ kpis.tasks_overdue }}</span>
                    <span class="projectplus-kpi__label">{{ __('Tarefas em atraso', 'projectplus') }}</span>
                    <span class="projectplus-kpi__sub">{{ __('Prazo vencido', 'projectplus') }}</span>
                </div>
            </div>
            {% endif %}
            <div class="projectplus-kpi">
                <span class="projectplus-kpi__icon projectplus-kpi__icon--green"><i class="ti ti-percentage"></i></span>
                <div>
                    <span class="projectplus-kpi__value">{{ kpis.avg_progress }}%</span>
                    <span class="projectplus-kpi__label">{{ __('Progresso médio', 'projectplus') }}</span>
                    <span class="projectplus-kpi__sub">{{ __('Percentual finalizado', 'projectplus') }}</span>
                </div>
            </div>
            <div class="projectplus-kpi">
                <span class="projectplus-kpi__icon projectplus-kpi__icon--indigo"><i class="ti ti-circle-check"></i></span>
                <div>
                    <span class="projectplus-kpi__value">{{ kpis.done_month }}</span>
                    <span class="projectplus-kpi__label">{{ __('Projetos concluídos', 'projectplus') }}</span>
                    <span class="projectplus-kpi__sub">{{ __('Este mês', 'projectplus') }}</span>
                </div>
            </div>
        </div>

        {# ================= LINHA 2: 4 donuts (Etapa 3, Bloco 4) ================= #}
        <div class="projectplus-row projectplus-row--charts">
            <div class="projectplus-card projectplus-card--chart">
                <h3>{{ __('Projetos por Status', 'projectplus') }}</h3>
                <div id="projectplus-status-chart" class="projectplus-donut"
                     data-done="{{ status_chart.done }}"
                     data-inprogress="{{ status_chart.in_progress }}"
                     data-planned="{{ status_chart.planned }}"
                     data-overdue="{{ status_chart.overdue }}"></div>
            </div>
            <div class="projectplus-card projectplus-card--chart">
                <h3>{{ __('Projetos por fase', 'projectplus') }}</h3>
                <div id="projectplus-phase-chart" class="projectplus-donut"
                     data-phases="{{ phase_chart|json_encode }}"></div>
            </div>
            {% if can_tasks %}
            <div class="projectplus-card projectplus-card--chart">
                <h3>{{ __('Tarefas por status', 'projectplus') }}</h3>
                <div id="projectplus-tasks-chart" class="projectplus-donut"
                     data-done="{{ tasks_chart.done }}"
                     data-inprogress="{{ tasks_chart.in_progress }}"
                     data-pending="{{ tasks_chart.pending }}"
                     data-overdue="{{ tasks_chart.overdue }}"></div>
            </div>
            <div class="projectplus-card projectplus-card--chart">
                <h3>{{ __('Tarefas por Estado', 'projectplus') }}</h3>
                <div id="projectplus-taskstate-chart" class="projectplus-donut"
                     data-phases="{{ task_state_chart|json_encode }}"></div>
            </div>
            {% endif %}
        </div>

        {# ================= LINHA 3: Projetos em andamento (largura total) ================= #}
        <div class="projectplus-row">
            <div class="projectplus-card projectplus-card--full" id="projects-table">
                <div class="pp-tablehead">
                    <h3>{{ __('Projetos em andamento', 'projectplus') }}</h3>
                    <input type="search" class="pp-tablesearch"
                           placeholder="{{ __('Buscar projeto…', 'projectplus') }}"
                           aria-label="{{ __('Buscar projeto', 'projectplus') }}">
                </div>
                <table class="projectplus-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>{{ __('Projeto', 'projectplus') }}</th>
                            <th>{{ __('Fase', 'projectplus') }}</th>
                            <th>{{ __('Progresso', 'projectplus') }}</th>
                            <th>{{ __('Última atividade', 'projectplus') }}</th>
                            <th>{{ __('Situação', 'projectplus') }}</th>
                            {% if can_costs %}<th>{{ __('Orçamento', 'projectplus') }}</th>{% endif %}
                            <th>{{ __('Prazo decorrido', 'projectplus') }}</th>
                            <th>{{ __('Prazo final', 'projectplus') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for project in projects %}
                        <tr class="projectplus-row-item" data-project-id="{{ project.id }}">
                            <td class="projectplus-expand">
                                {% if project.children > 0 %}
                                    <button type="button" class="projectplus-expand__btn"
                                            title="{{ project.children }} subprojeto(s)"
                                            data-project-id="{{ project.id }}">+</button>
                                {% endif %}
                            </td>
                            <td>{% if project.blocked %}<span class="pp-dep-lock"
                                    title="{{ __('Projeto com tarefas/subprojetos abertos — não pode ir para fase concluída', 'projectplus') }}">🔒</span> {% endif %}<a href="{{ project.url }}">{{ project.name }}</a>
                                {% if can_tasks %}
                                <button type="button" class="projectplus-tasksbtn"
                                        data-tasks-project="{{ project.id }}">{{ __('Tarefas', 'projectplus') }}</button>
                                {% endif %}
                            </td>
                            <td class="pp-phase-cell">
                                {% if project.state_name %}
                                    <span class="pp-phase" style="--pp-phase-color: {{ project.state_color }}">{{ project.state_name }}</span>
                                {% else %}
                                    <span class="projectplus-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="projectplus-progress">
                                    <div class="projectplus-progress__bar" style="width: {{ project.percent_done }}%"></div>
                                </div>
                                <span class="projectplus-progress__pct">{{ project.percent_done }}%</span>
                            </td>
                            <td>{{ project.last_activity|date('d/m/Y H:i') }}</td>
                            <td>
                                {% if project.is_overdue %}
                                    <span class="projectplus-badge projectplus-badge--overdue">{{ __('Atrasado', 'projectplus') }}</span>
                                {% elseif project.is_stalled %}
                                    <span class="projectplus-badge projectplus-badge--stalled">{{ __('Parado', 'projectplus') }}</span>
                                {% else %}
                                    <span class="projectplus-badge projectplus-badge--ok">{{ __('No prazo', 'projectplus') }}</span>
                                {% endif %}
                            </td>
                            {% if can_costs %}
                            <td class="projectplus-budget-cell">
                                {% if project.budget %}
                                    <div class="projectplus-budgetbar"><div
                                        class="projectplus-budgetbar__fill projectplus-budgetbar__fill--{{ project.budget.state }}"
                                        style="width: {{ project.budget.percent > 100 ? 100 : project.budget.percent }}%"></div></div>
                                    {{ project.budget.percent }}%
                                    <span class="projectplus-muted">({{ project.budget.spent_fmt }} / {{ project.budget.planned_fmt }})</span>
                                {% else %}
                                    <span class="projectplus-muted">—</span>
                                {% endif %}
                            </td>
                            {% endif %}
                            <td class="pp-deadline-cell">
                                {% if project.deadline.state == 'done' %}
                                    <span class="projectplus-muted">—</span>
                                {% elseif project.deadline.state == 'none' %}
                                    <div class="pp-deadline pp-deadline--none"
                                         title="{{ __('Sem datas planejadas — corrija o planejamento', 'projectplus') }}"><div
                                        class="pp-deadline__fill" style="width:0%"></div></div>
                                    <span class="projectplus-muted">—</span>
                                {% else %}
                                    <div class="pp-deadline"><div
                                        class="pp-deadline__fill pp-deadline__fill--{{ project.deadline.state }}"
                                        style="width: {{ project.deadline.display }}%"></div></div>
                                    <span class="pp-deadline__label pp-deadline__label--{{ project.deadline.state }}">{{ project.deadline.label }}</span>
                                {% endif %}
                            </td>
                            <td>{{ project.plan_end_date ? project.plan_end_date|date('d/m/Y') : '—' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ can_costs ? 9 : 8 }}">{{ __('Nenhum projeto no período', 'projectplus') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# ================= LINHA 4: Tarefas em andamento (largura total) =================
           Bloco 4: bloco inteiro escondido para quem não tem o direito de
           Tarefas (papel Cliente) — ele acompanha o projeto, não a tarefa. #}
        {% if can_tasks %}
        <div class="projectplus-row">
            <div class="projectplus-card projectplus-card--full" id="tasks-table">
                <div class="pp-tablehead">
                    <h3>{{ __('Tarefas em andamento', 'projectplus') }}</h3>
                    <input type="search" class="pp-tablesearch"
                           placeholder="{{ __('Buscar tarefa…', 'projectplus') }}"
                           aria-label="{{ __('Buscar tarefa', 'projectplus') }}">
                </div>
                <table class="projectplus-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>{{ __('Tarefa', 'projectplus') }}</th>
                            <th>{{ __('Projeto', 'projectplus') }}</th>
                            <th>{{ __('Responsáveis', 'projectplus') }}</th>
                            <th>{{ __('Progresso', 'projectplus') }}</th>
                            <th>{{ __('Estado', 'projectplus') }}</th>
                            <th>{{ __('Prazo decorrido', 'projectplus') }}</th>
                            <th>{{ __('Prazo final', 'projectplus') }}</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for task in open_tasks %}
                        <tr data-depth="0" data-task-id="{{ task.id }}">
                            <td class="projectplus-expand">
                                {% if task.children > 0 %}
                                    <button type="button" class="projectplus-expand__btn pp-taskexp"
                                            title="{{ task.children }} subtarefa(s)"
                                            data-task-id="{{ task.id }}">+</button>
                                {% endif %}
                            </td>
                            <td>{% if task.blocked %}<span class="pp-dep-lock"
                                    title="{{ __('Bloqueada por outra(s) tarefa(s) — veja 🔗', 'projectplus') }}">🔒</span> {% endif %}<a href="{{ task.url }}" target="_blank">{{ task.name }}</a></td>
                            <td>{{ task.project }}</td>
                            <td>
                                {% if task.team %}
                                    {{ task.team|join(', ') }}
                                {% else %}
                                    <span class="projectplus-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="projectplus-progress">
                                    <div class="projectplus-progress__bar" style="width: {{ task.percent }}%"></div>
                                </div>
                                <span class="projectplus-progress__pct">{{ task.percent }}%</span>
                            </td>
                            <td class="pp-phase-cell">
                                {% if task.state_name %}
                                    <span class="pp-phase" style="--pp-phase-color: {{ task.state_color }}">{{ task.state_name }}</span>
                                {% else %}
                                    <span class="projectplus-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="pp-deadline-cell">
                                {% if task.deadline.state == 'done' %}
                                    <span class="projectplus-muted">—</span>
                                {% elseif task.deadline.state == 'none' %}
                                    <div class="pp-deadline pp-deadline--none"
                                         title="{{ __('Sem datas planejadas — corrija o planejamento', 'projectplus') }}"><div
                                        class="pp-deadline__fill" style="width:0%"></div></div>
                                    <span class="projectplus-muted">—</span>
                                {% else %}
                                    <div class="pp-deadline"><div
                                        class="pp-deadline__fill pp-deadline__fill--{{ task.deadline.state }}"
                                        style="width: {{ task.deadline.display }}%"></div></div>
                                    <span class="pp-deadline__label pp-deadline__label--{{ task.deadline.state }}">{{ task.deadline.label }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if task.is_overdue %}
                                    <span class="projectplus-badge projectplus-badge--overdue">{{ task.end }}</span>
                                {% else %}
                                    {{ task.end ?: '—' }}
                                {% endif %}
                            </td>
                            <td class="pp-dep-cell">
                                <button type="button" class="pp-dep-btn{% if task.deps > 0 %} pp-dep-btn--has{% endif %}{% if task.blocked %} pp-dep-btn--blocked{% endif %}"
                                        title="{{ __('Dependências', 'projectplus') }}">🔗{% if task.deps > 0 %}<span class="pp-dep-count">{{ task.deps }}</span>{% endif %}</button>
                            </td>
                            <td class="pp-cmt-cell">
                                <button type="button" class="pp-cmt-btn{% if task.comments > 0 %} pp-cmt-btn--has{% endif %}"
                                        title="{{ __('Comentários', 'projectplus') }}">💬{% if task.comments > 0 %}<span class="pp-cmt-count">{{ task.comments }}</span>{% endif %}</button>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="10">{{ __('Nenhuma tarefa no período', 'projectplus') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endif %}

    </div>
</div>

{# ================= MODAL: NOVO PROJETO ================= #}
{% if can_create %}
<div class="projectplus-modal" id="pp-modal-newproject" hidden>
    <div class="projectplus-modal__backdrop" data-pp-modal-close></div>
    <div class="projectplus-modal__box">
        <div class="projectplus-modal__head">
            <h3>{{ __('Novo projeto', 'projectplus') }}</h3>
            <button type="button" class="projectplus-modal__x" data-pp-modal-close>&times;</button>
        </div>
        <form method="post" action="{{ plugin_web_dir }}/front/project_create.form.php"
              class="projectplus-form">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

            <label class="projectplus-form__full">
                {{ __('Nome do projeto', 'projectplus') }} *
                <input type="text" name="name" required maxlength="255" autofocus>
            </label>

            <label>
                {{ __('Projeto pai', 'projectplus') }}
                <select name="projects_id">
                    <option value="0">{{ __('— Nenhum (projeto raiz) —', 'projectplus') }}</option>
                    {% for p in parents %}
                        <option value="{{ p.id }}">{{ p.name }}</option>
                    {% endfor %}
                </select>
            </label>

            <label>
                {{ __('Estado', 'projectplus') }}
                <select name="projectstates_id">
                    <option value="0">—</option>
                    {% for s in states %}
                        <option value="{{ s.id }}">{{ s.name }}</option>
                    {% endfor %}
                </select>
            </label>

            <label>
                {{ __('Prioridade', 'projectplus') }}
                <select name="priority">
                    <option value="1">{{ __('Muito baixa', 'projectplus') }}</option>
                    <option value="2">{{ __('Baixa', 'projectplus') }}</option>
                    <option value="3" selected>{{ __('Média', 'projectplus') }}</option>
                    <option value="4">{{ __('Alta', 'projectplus') }}</option>
                    <option value="5">{{ __('Muito alta', 'projectplus') }}</option>
                    <option value="6">{{ __('Crítica', 'projectplus') }}</option>
                </select>
            </label>

            <label>
                {{ __('Gestor', 'projectplus') }}
                <select name="users_id">
                    {% for u in users %}
                        <option value="{{ u.id }}" {{ u.id == current_user_id ? 'selected' : '' }}>{{ u.name }}</option>
                    {% endfor %}
                </select>
            </label>

            <label>
                {{ __('Início planejado', 'projectplus') }}
                <input type="date" name="plan_start_date">
            </label>

            <label>
                {{ __('Fim planejado', 'projectplus') }}
                <input type="date" name="plan_end_date">
            </label>

            {% if can_costs %}
            <label>
                {{ __('Teto de orçamento', 'projectplus') }}
                <input type="number" name="budget_planned" step="0.01" min="0" placeholder="0,00">
            </label>
            {% endif %}

            <label class="projectplus-form__full">
                {{ __('Descrição', 'projectplus') }}
                <textarea name="content" rows="3"></textarea>
            </label>

            <div class="projectplus-form__footer">
                <button type="button" class="projectplus-btn projectplus-btn--ghost" data-pp-modal-close>
                    {{ __('Cancelar', 'projectplus') }}
                </button>
                <button type="submit" class="projectplus-btn">
                    {{ __('Criar projeto', 'projectplus') }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endif %}

<script id="pp-data" type="application/json">{{ {
    'states': states,
    'users': users,
    'current_user_id': current_user_id
}|json_encode|raw }}</script>


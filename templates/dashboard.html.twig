{# ProjectPlus — Visão Geral no padrão do esboço (Etapa 3, Bloco 3.2) #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/projectplus.css">

<div class="projectplus-app" id="projectplus-dashboard"
     data-ajax-url="{{ plugin_web_dir }}/ajax/dashboard_data.php"
     data-task-url="{{ plugin_web_dir }}/ajax/task.php"
     data-comment-url="{{ plugin_web_dir }}/ajax/comment.php"
     data-dep-url="{{ plugin_web_dir }}/ajax/taskdep.php"
     data-project-url="{{ plugin_web_dir }}/ajax/project.php"
     data-alerts-url="{{ plugin_web_dir }}/ajax/alerts.php"
     data-csrf="{{ csrf_token }}"
     {# Bloco 4: o JS monta as linhas de subprojeto/tarefa no cliente e
        precisa saber quais colunas existem nesta tela. #}
     data-pp-costs="{{ can_costs ? '1' : '0' }}"
     data-pp-tasks="{{ can_tasks ? '1' : '0' }}"
     {# Bloco A: projeto focado (?project=ID) e tarefa a destacar #}
     data-focus-project="{{ focus_project_id|default(0) }}"
     data-focus-task="{{ focus_task_id|default(0) }}">

    {# Bloco N-1a: barra superior no lugar da coluna lateral #}
    {% include '@projectplus/_topbar.html.twig' with {pp_active: 'painel', pp_title: __('Painel', 'projectplus'), pp_sub: head_sub, pp_meta: head_meta, pp_bell: nav.alerts, pp_new: can_create} %}

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="projectplus-main">

        {# ===== Bloco N-2: faixa de filtros (período, tipo, escopo, favorito) =====
           Tipo e datas aplicam sozinhos ao mudar — não há mais o botão "Aplicar". #}
        <div class="pp-filterbar" id="overview">
            {% include '@projectplus/_favorite.html.twig' %}
            <span class="pp-filterbar__sep"></span>
            <form method="get" class="pp-filterbar__form" action="">
                {% if filter_scope %}<input type="hidden" name="scope" value="{{ filter_scope }}">{% endif %}
                <span class="pp-filterbar__label">{{ __('Período', 'projectplus') }}</span>
                <input type="date" name="from" value="{{ filter_from }}" title="{{ __('Início do período', 'projectplus') }}" onchange="this.form.submit()">
                <span class="pp-filterbar__muted">{{ __('até', 'projectplus') }}</span>
                <input type="date" name="until" value="{{ filter_until }}" title="{{ __('Fim do período', 'projectplus') }}" onchange="this.form.submit()">
                {% if type_options is not empty and not nav.client %}
                <span class="pp-filterbar__label">{{ __('Tipo', 'projectplus') }}</span>
                <select name="type" class="pp-type-pick" title="{{ __('Tipo de projeto', 'projectplus') }}" onchange="this.form.submit()">
                    <option value="">{{ __('Todos os tipos', 'projectplus') }}</option>
                    {% for t in type_options %}
                    <option value="{{ t.id }}" {{ (filter_type is not null and filter_type == t.id) ? 'selected' : '' }}>{{ t.name }}</option>
                    {% endfor %}
                </select>
                {% endif %}
                <noscript><button type="submit" class="projectplus-btn projectplus-btn--ghost">{{ __('Aplicar', 'projectplus') }}</button></noscript>
                {% if filter_from or filter_until or filter_type is not null %}
                    <a href="?" class="projectplus-period__clear" title="{{ __('Limpar filtro', 'projectplus') }}">&times;</a>
                {% endif %}
            </form>
            {% if scope_can_expand and not nav.client %}
            <div class="pp-seg pp-seg--links" role="group" aria-label="{{ __('Escopo', 'projectplus') }}">
                {% if scope_is_expanded %}
                <span class="pp-seg__btn pp-seg__btn--active" aria-current="true">{{ __('Todos', 'projectplus') }}</span>
                <a class="pp-seg__btn" href="{{ scope_toggle_url }}" title="{{ __('Voltar ao escopo pessoal', 'projectplus') }}">{{ __('Só os meus', 'projectplus') }}</a>
                {% else %}
                <a class="pp-seg__btn" href="{{ scope_toggle_url }}" title="{{ __('Incluir todos os projetos que você pode ver', 'projectplus') }}">{{ __('Todos', 'projectplus') }}</a>
                <span class="pp-seg__btn pp-seg__btn--active" aria-current="true">{{ __('Só os meus', 'projectplus') }}</span>
                {% endif %}
            </div>
            {% endif %}
            {% if focus_project_id %}
            <div class="projectplus-focus">
                <span class="projectplus-focus__label">{{ __('Projeto', 'projectplus') }}:</span>
                <strong>{{ focus_project_name }}</strong>
                <a href="{{ plugin_web_dir }}/front/dashboard.php"
                   class="projectplus-period__clear"
                   title="{{ __('Ver todos os projetos', 'projectplus') }}">&times;</a>
            </div>
            {% elseif focus_error %}
            <div class="projectplus-focus projectplus-focus--error">
                {{ __('Projeto não encontrado ou fora do seu escopo', 'projectplus') }}
            </div>
            {% endif %}
            <span class="pp-filterbar__spacer"></span>
            {% if not nav.client %}
            <a class="pp-filterbar__link" href="{{ glpi_root }}/front/project.php">{{ __('Lista nativa', 'projectplus') }}</a>
            {% endif %}
        </div>

        {# ===== Bloco N-2: indicadores ===== #}
        <div class="pp-kpis">
            <div class="pp-kpi">
                <span class="pp-kpi__label">{{ __('Projetos ativos', 'projectplus') }}</span>
                <span class="pp-kpi__value">{{ kpis.active }}</span>
                <span class="pp-kpi__sub">{{ _n('em %d tipo', 'em %d tipos', kpi_types, 'projectplus')|format(kpi_types) }}</span>
            </div>
            <div class="pp-kpi">
                <span class="pp-kpi__label">{{ __('Projetos em atraso', 'projectplus') }}</span>
                <span class="pp-kpi__value{{ kpis.overdue > 0 ? ' pp-kpi__value--danger' : '' }}">{{ kpis.overdue }}</span>
                <span class="pp-kpi__sub">{{ __('em risco', 'projectplus') }}</span>
            </div>
            {% if can_tasks %}
            <div class="pp-kpi">
                <span class="pp-kpi__label">{{ __('Tarefas abertas', 'projectplus') }}</span>
                <span class="pp-kpi__value">{{ kpis.open_tasks }}</span>
                <span class="pp-kpi__sub">{{ __('em andamento', 'projectplus') }}</span>
            </div>
            <div class="pp-kpi">
                <span class="pp-kpi__label">{{ __('Tarefas atrasadas', 'projectplus') }}</span>
                <span class="pp-kpi__value{{ kpis.tasks_overdue > 0 ? ' pp-kpi__value--danger' : '' }}">{{ kpis.tasks_overdue }}</span>
                <span class="pp-kpi__sub{{ kpis.tasks_overdue > 0 ? ' pp-kpi__sub--warn' : '' }}">{{ __('prazo vencido', 'projectplus') }}</span>
            </div>
            {% endif %}
            <div class="pp-kpi">
                <span class="pp-kpi__label">{{ __('Progresso médio', 'projectplus') }}</span>
                <span class="pp-kpi__value">{{ kpis.avg_progress }}%</span>
                <span class="pp-kpi__sub">{{ __('percentual finalizado', 'projectplus') }}</span>
            </div>
            <div class="pp-kpi">
                <span class="pp-kpi__label">{{ __('Concluídos no mês', 'projectplus') }}</span>
                <span class="pp-kpi__value">{{ kpis.done_month }}</span>
                <span class="pp-kpi__sub">{{ month_name }}</span>
            </div>
        </div>

        {# ===== Bloco N-2: painéis (situação, tipo/fase, tarefas por fase, atenção) =====
           Donuts desenhados no servidor (SVG), segmentos de Dashboard::donutSegments(). #}
        <div class="pp-panels">
            <div class="pp-panel">
                <h3 class="pp-panel__title">{{ __('Situação dos projetos', 'projectplus') }}</h3>
                <div class="pp-donut">
                    <svg class="pp-donut__svg" width="120" height="120" viewBox="0 0 120 120" role="img"
                         aria-label="{{ __('Situação dos projetos', 'projectplus') }}">
                        <circle cx="60" cy="60" r="48" class="pp-donut__track"></circle>
                        {% for seg in situation.segs %}
                        <circle cx="60" cy="60" r="48" class="pp-donut__seg" style="stroke: {{ seg.color }}"
                                stroke-dasharray="{{ seg.dash }} 301.59" stroke-dashoffset="{{ seg.offset }}"
                                transform="rotate(-90 60 60)"></circle>
                        {% endfor %}
                        <text x="60" y="61" text-anchor="middle" class="pp-donut__big">{{ situation.center }}</text>
                        <text x="60" y="78" text-anchor="middle" class="pp-donut__small">{{ __('no prazo', 'projectplus') }}</text>
                    </svg>
                    <ul class="pp-legend">
                        {% for it in situation.items %}
                        <li><span class="pp-legend__dot" style="background: {{ it.color }}"></span><span class="pp-legend__name">{{ it.name }}</span><b>{{ it.count }}</b></li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            {# Etapa 9 — donut ADAPTATIVO: sem tipo escolhido, "por tipo"; com tipo, "por fase". #}
            <div class="pp-panel">
                <h3 class="pp-panel__title">{{ filter_type is null ? __('Por tipo', 'projectplus') : __('Por fase', 'projectplus') }}</h3>
                {% if second_donut.total > 0 %}
                <div class="pp-donut">
                    <svg class="pp-donut__svg" width="120" height="120" viewBox="0 0 120 120" role="img"
                         aria-label="{{ filter_type is null ? __('Por tipo', 'projectplus') : __('Por fase', 'projectplus') }}">
                        <circle cx="60" cy="60" r="48" class="pp-donut__track"></circle>
                        {% for seg in second_donut.segs %}
                        <circle cx="60" cy="60" r="48" class="pp-donut__seg" style="stroke: {{ seg.color }}"
                                stroke-dasharray="{{ seg.dash }} 301.59" stroke-dashoffset="{{ seg.offset }}"
                                transform="rotate(-90 60 60)"></circle>
                        {% endfor %}
                        <text x="60" y="64" text-anchor="middle" class="pp-donut__big">{{ second_donut.total }}</text>
                        <text x="60" y="80" text-anchor="middle" class="pp-donut__small">{{ _n('projeto', 'projetos', second_donut.total, 'projectplus') }}</text>
                    </svg>
                    <ul class="pp-legend">
                        {% for it in second_donut.segs %}
                        <li><span class="pp-legend__dot" style="background: {{ it.color }}"></span><span class="pp-legend__name">{{ it.name }}</span><b>{{ it.count }}</b></li>
                        {% endfor %}
                    </ul>
                </div>
                {% else %}
                <p class="pp-panel__empty">{{ __('Nenhum projeto no período', 'projectplus') }}</p>
                {% endif %}
            </div>

            {% if can_tasks %}
            <div class="pp-panel">
                <h3 class="pp-panel__title">{{ __('Tarefas por fase', 'projectplus') }}</h3>
                {% if task_bars %}
                <ul class="pp-bars">
                    {% for b in task_bars %}
                    <li>
                        <div class="pp-bars__row"><span><span class="pp-legend__dot" style="background: {{ b.color }}"></span>{{ b.name }}</span><b>{{ b.count }}</b></div>
                        <div class="pp-bars__track"><div class="pp-bars__fill" style="width: {{ b.pct }}%; background: {{ b.color }}"></div></div>
                    </li>
                    {% endfor %}
                </ul>
                {% else %}
                <p class="pp-panel__empty">{{ __('Nenhuma tarefa no período', 'projectplus') }}</p>
                {% endif %}
            </div>
            {% endif %}

            <div class="pp-panel">
                <h3 class="pp-panel__title">{{ __('Precisa de atenção', 'projectplus') }}</h3>
                <ul class="pp-attn">
                    {% for a in attention %}
                    <li><span>{{ a.label }}</span><span class="pp-attn__count pp-attn__count--{{ a.count > 0 ? a.level : 'zero' }}">{{ a.count }}</span></li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        {# ================= LINHA 3: Projetos em andamento (largura total) =================
           Bloco N-2: ordem das colunas do mockup — Fase, Progresso, Prazo decorrido, Prazo final,
           Situação, Última atividade, [Orçamento], Ações (Tarefas + 💬). A MESMA ordem está em
           projectRowCells() do projectplus.js (subprojetos e redesenho pela faixa). #}
        <div class="projectplus-row">
            <div class="projectplus-card projectplus-card--full pp-tablecard" id="projects-table">
                <div class="pp-tablehead">
                    <h3>{{ __('Projetos em andamento', 'projectplus') }}</h3>
                    <input type="search" class="pp-tablesearch"
                           placeholder="{{ __('Buscar projeto…', 'projectplus') }}"
                           aria-label="{{ __('Buscar projeto', 'projectplus') }}">
                </div>
                <div class="pp-tablewrap">
                <table class="projectplus-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>{{ __('Projeto', 'projectplus') }}</th>
                            <th>{{ __('Fase', 'projectplus') }}</th>
                            <th>{{ __('Progresso', 'projectplus') }}</th>
                            <th>{{ __('Prazo decorrido', 'projectplus') }}</th>
                            <th>{{ __('Prazo final', 'projectplus') }}</th>
                            <th>{{ __('Situação', 'projectplus') }}</th>
                            <th>{{ __('Última atividade', 'projectplus') }}</th>
                            {% if can_costs %}<th>{{ __('Orçamento', 'projectplus') }}</th>{% endif %}
                            <th class="pp-actions-cell">{{ __('Ações', 'projectplus') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for project in projects %}
                        <tr class="projectplus-row-item" data-project-id="{{ project.id }}">
                            <td class="projectplus-expand">
                                {% if project.children > 0 %}
                                    <button type="button" class="projectplus-expand__btn"
                                            title="{{ project.children }} subprojeto(s)"
                                            data-project-id="{{ project.id }}">+</button>
                                {% endif %}
                            </td>
                            <td class="pp-name-cell">{% if project.blocked %}<span class="pp-dep-lock"
                                    title="{{ __('Tarefas ou subprojetos abertos — só o gestor pode finalizar, com confirmação', 'projectplus') }}">🔒</span> {% endif %}<a href="{{ project.url }}">{{ project.name }}</a></td>
                            <td class="pp-phase-cell">
                                {% if project.state_name %}
                                    <span class="pp-phase" style="--pp-phase-color: {{ project.state_color }}">{{ project.state_name }}</span>
                                {% else %}
                                    <span class="projectplus-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="projectplus-progress">
                                    <div class="projectplus-progress__bar" style="width: {{ project.percent_done }}%"></div>
                                </div>
                                <span class="projectplus-progress__pct">{{ project.percent_done }}%</span>
                            </td>
                            <td class="pp-deadline-cell">
                                {% if project.deadline.state == 'done' %}
                                    <span class="projectplus-muted">—</span>
                                {% elseif project.deadline.state == 'none' %}
                                    <span class="projectplus-muted" title="{{ __('Sem datas planejadas — corrija o planejamento', 'projectplus') }}">{{ __('sem datas', 'projectplus') }}</span>
                                {% else %}
                                    <div class="pp-deadline"><div
                                        class="pp-deadline__fill pp-deadline__fill--{{ project.deadline.state }}"
                                        style="width: {{ project.deadline.display }}%"></div></div>
                                    <span class="pp-deadline__label pp-deadline__label--{{ project.deadline.state }}">{{ project.deadline.label }}</span>
                                {% endif %}
                            </td>
                            <td>{{ project.plan_end_date ? project.plan_end_date|formatted_date : '—' }}</td>
                            <td>
                                {% if project.is_overdue %}
                                    <span class="projectplus-badge projectplus-badge--overdue">{{ __('Atrasado', 'projectplus') }}</span>
                                {% elseif project.is_stalled %}
                                    <span class="projectplus-badge projectplus-badge--stalled">{{ __('Parado', 'projectplus') }}</span>
                                {% else %}
                                    <span class="projectplus-badge projectplus-badge--ok">{{ __('No prazo', 'projectplus') }}</span>
                                {% endif %}
                            </td>
                            <td class="pp-muted-cell">{{ project.last_activity|formatted_datetime }}</td>
                            {% if can_costs %}
                            <td class="projectplus-budget-cell">
                                {% if project.budget %}
                                    <div class="projectplus-budgetbar"><div
                                        class="projectplus-budgetbar__fill projectplus-budgetbar__fill--{{ project.budget.state }}"
                                        style="width: {{ project.budget.percent > 100 ? 100 : project.budget.percent }}%"></div></div>
                                    {{ project.budget.percent }}%
                                    <span class="projectplus-muted">({{ project.budget.spent_fmt }} / {{ project.budget.planned_fmt }})</span>
                                {% else %}
                                    <span class="projectplus-muted">—</span>
                                {% endif %}
                            </td>
                            {% endif %}
                            {# Bloco F-2b: 💬 do projeto para quem o enxerga; Bloco N-2: Tarefas veio para cá #}
                            <td class="pp-actions-cell pp-cmt-cell">
                                {% if can_tasks %}<button type="button" class="projectplus-tasksbtn"
                                        data-tasks-project="{{ project.id }}">{{ __('Tarefas', 'projectplus') }}</button>{% endif %}
                                <button type="button" class="pp-cmt-btn{% if project.comments > 0 %} pp-cmt-btn--has{% endif %}"
                                        title="{{ __('Comentários', 'projectplus') }}" aria-label="{{ __('Comentários', 'projectplus') }}"><i class="ti ti-message"></i>{% if project.comments > 0 %}<span class="pp-cmt-count">{{ project.comments }}</span>{% endif %}</button>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="{{ can_costs ? 10 : 9 }}">{{ __('Nenhum projeto no período', 'projectplus') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
            </div>
        </div>

        {# ================= LINHA 4: Tarefas em andamento (largura total) =================
           Bloco 4: bloco inteiro escondido para quem não tem o direito de
           Tarefas (papel Cliente) — ele acompanha o projeto, não a tarefa. #}
        {% if can_tasks %}
        <div class="projectplus-row">
            <div class="projectplus-card projectplus-card--full pp-tablecard" id="tasks-table">
                <div class="pp-tablehead">
                    <h3>{{ __('Tarefas em andamento', 'projectplus') }}</h3>
                    <input type="search" class="pp-tablesearch"
                           placeholder="{{ __('Buscar tarefa…', 'projectplus') }}"
                           aria-label="{{ __('Buscar tarefa', 'projectplus') }}">
                </div>
                <div class="pp-tablewrap">
                <table class="projectplus-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>{{ __('Tarefa', 'projectplus') }}</th>
                            <th>{{ __('Projeto', 'projectplus') }}</th>
                            <th>{{ __('Responsáveis', 'projectplus') }}</th>
                            <th>{{ __('Fase', 'projectplus') }}</th>
                            <th>{{ __('Progresso', 'projectplus') }}</th>
                            <th>{{ __('Prazo decorrido', 'projectplus') }}</th>
                            <th>{{ __('Prazo final', 'projectplus') }}</th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for task in open_tasks %}
                        <tr data-depth="0" data-task-id="{{ task.id }}">
                            <td class="projectplus-expand">
                                {% if task.children > 0 %}
                                    <button type="button" class="projectplus-expand__btn pp-taskexp"
                                            title="{{ task.children }} subtarefa(s)"
                                            data-task-id="{{ task.id }}">+</button>
                                {% endif %}
                            </td>
                            <td>{% if task.blocked %}<span class="pp-dep-lock"
                                    title="{{ __('Bloqueada por outra(s) tarefa(s) — veja 🔗', 'projectplus') }}">🔒</span> {% endif %}<a href="{{ task.url }}" target="_blank">{{ task.name }}</a></td>
                            <td>{{ task.project }}</td>
                            <td>
                                {% if task.team %}
                                    {% for member in task.team %}<span class="pp-person">{{ member }}</span>{% endfor %}
                                {% else %}
                                    <span class="projectplus-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="pp-phase-cell">
                                {% if task.state_name %}
                                    <span class="pp-phase" style="--pp-phase-color: {{ task.state_color }}">{{ task.state_name }}</span>
                                {% else %}
                                    <span class="projectplus-muted">—</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="projectplus-progress">
                                    <div class="projectplus-progress__bar" style="width: {{ task.percent }}%"></div>
                                </div>
                                <span class="projectplus-progress__pct">{{ task.percent }}%</span>
                            </td>
                            <td class="pp-deadline-cell">
                                {% if task.deadline.state == 'done' %}
                                    <span class="projectplus-muted">—</span>
                                {% elseif task.deadline.state == 'none' %}
                                    <div class="pp-deadline pp-deadline--none"
                                         title="{{ __('Sem datas planejadas — corrija o planejamento', 'projectplus') }}"><div
                                        class="pp-deadline__fill" style="width:0%"></div></div>
                                    <span class="projectplus-muted">—</span>
                                {% else %}
                                    <div class="pp-deadline"><div
                                        class="pp-deadline__fill pp-deadline__fill--{{ task.deadline.state }}"
                                        style="width: {{ task.deadline.display }}%"></div></div>
                                    <span class="pp-deadline__label pp-deadline__label--{{ task.deadline.state }}">{{ task.deadline.label }}</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if task.is_overdue %}
                                    <span class="projectplus-badge projectplus-badge--overdue">{{ task.end }}</span>
                                {% else %}
                                    {{ task.end ?: '—' }}
                                {% endif %}
                            </td>
                            <td class="pp-dep-cell">
                                <button type="button" class="pp-dep-btn{% if task.deps > 0 %} pp-dep-btn--has{% endif %}{% if task.blocked %} pp-dep-btn--blocked{% endif %}"
                                        title="{{ __('Dependências', 'projectplus') }}" aria-label="{{ __('Dependências', 'projectplus') }}"><i class="ti ti-link"></i>{% if task.deps > 0 %}<span class="pp-dep-count">{{ task.deps }}</span>{% endif %}</button>
                            </td>
                            <td class="pp-cmt-cell">
                                <button type="button" class="pp-cmt-btn{% if task.comments > 0 %} pp-cmt-btn--has{% endif %}"
                                        title="{{ __('Comentários', 'projectplus') }}" aria-label="{{ __('Comentários', 'projectplus') }}"><i class="ti ti-message"></i>{% if task.comments > 0 %}<span class="pp-cmt-count">{{ task.comments }}</span>{% endif %}</button>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="10">{{ __('Nenhuma tarefa no período', 'projectplus') }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
            </div>
        </div>
        {% endif %}

    </div>
</div>

{# ================= MODAL: NOVO PROJETO ================= #}
{% if can_create %}
<div class="projectplus-modal" id="pp-modal-newproject" hidden>
    <div class="projectplus-modal__backdrop" data-pp-modal-close></div>
    <div class="projectplus-modal__box">
        <div class="projectplus-modal__head">
            <h3>{{ __('Novo projeto', 'projectplus') }}</h3>
            <button type="button" class="projectplus-modal__x" data-pp-modal-close>&times;</button>
        </div>
        <form method="post" action="{{ plugin_web_dir }}/front/project_create.form.php"
              class="projectplus-form">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

            <label class="projectplus-form__full">
                {{ __('Nome do projeto', 'projectplus') }} *
                <input type="text" name="name" required maxlength="255" autofocus>
            </label>

            {# Bloco J (21/10/2026): criar a partir de um modelo do plugin. Escolhendo
               um, o JS pré-preenche gestor/tipo/fase/orçamento/descrição a partir do
               modelo (o usuário ajusta); tarefas, subprojetos e o fim vêm do modelo. #}
            {% if templates is not empty %}
            <label class="projectplus-form__full">
                {{ __('Modelo', 'projectplus') }}
                <select name="template_id" data-pp-role="np-template">
                    <option value="0">{{ __('— Em branco (sem modelo) —', 'projectplus') }}</option>
                    {% for t in templates %}
                        <option value="{{ t.id }}">{{ t.name }} ({{ _n('%d tarefa', '%d tarefas', t.count, 'projectplus')|format(t.count) }}{% if t.subcount > 0 %}, {{ _n('%d subprojeto', '%d subprojetos', t.subcount, 'projectplus')|format(t.subcount) }}{% endif %})</option>
                    {% endfor %}
                </select>
                <small class="projectplus-muted pp-np-tplhint" data-pp-role="np-template-hint" hidden>
                    {{ __('Tarefas, subprojetos e o fim planejado vêm do modelo; os demais campos foram preenchidos com o modelo e podem ser ajustados.', 'projectplus') }}
                </small>
            </label>
            {% endif %}

            <label>
                {{ __('Projeto pai', 'projectplus') }}
                <select name="projects_id" class="pp-search">
                    <option value="0">{{ __('— Nenhum (projeto raiz) —', 'projectplus') }}</option>
                    {% for p in parents %}
                        <option value="{{ p.id }}">{{ p.name }}</option>
                    {% endfor %}
                </select>
            </label>

            <label>
                {{ __('Tipo', 'projectplus') }}
                <select name="projecttypes_id" data-pp-role="np-type">
                    <option value="0">—</option>
                    {% for t in ptypes %}
                        <option value="{{ t.id }}">{{ t.name }}</option>
                    {% endfor %}
                </select>
            </label>

            {# O campo Fase lista só as fases do conjunto do TIPO escolhido
               (Etapa 9). Sem tipo, mostra o conjunto padrão. #}
            <label>
                {{ __('Fase', 'projectplus') }}
                <select name="projectstates_id" data-pp-role="np-state">
                    <option value="0">—</option>
                    {% for s in states %}
                        <option value="{{ s.id }}">{{ s.name }}</option>
                    {% endfor %}
                </select>
            </label>

            <label>
                {{ __('Prioridade', 'projectplus') }}
                <select name="priority">
                    <option value="1">{{ __('Muito baixa', 'projectplus') }}</option>
                    <option value="2">{{ __('Baixa', 'projectplus') }}</option>
                    <option value="3" selected>{{ __('Média', 'projectplus') }}</option>
                    <option value="4">{{ __('Alta', 'projectplus') }}</option>
                    <option value="5">{{ __('Muito alta', 'projectplus') }}</option>
                    <option value="6">{{ __('Crítica', 'projectplus') }}</option>
                </select>
            </label>

            <label>
                {{ __('Gestor', 'projectplus') }}
                <select name="users_id" class="pp-search">
                    {% for u in users %}
                        <option value="{{ u.id }}" {{ u.id == current_user_id ? 'selected' : '' }}>{{ u.name }}</option>
                    {% endfor %}
                </select>
            </label>

            <label>
                <span data-pp-role="np-start-label">{{ __('Início planejado', 'projectplus') }}</span>
                <input type="date" name="plan_start_date" data-pp-role="np-start">
            </label>

            <label>
                {{ __('Fim planejado', 'projectplus') }}
                <input type="date" name="plan_end_date" data-pp-role="np-end">
            </label>

            {% if can_costs %}
            <label>
                {{ __('Teto de orçamento', 'projectplus') }}
                <input type="number" name="budget_planned" step="0.01" min="0" placeholder="0,00">
            </label>
            {% endif %}

            <label class="projectplus-form__full">
                {{ __('Descrição', 'projectplus') }}{% if desc_required %} <span class="pp-req" aria-hidden="true">*</span>{% endif %}
                <textarea name="content" rows="3"{{ desc_required ? ' required' : '' }}></textarea>
            </label>

            <div class="projectplus-form__footer">
                <button type="button" class="projectplus-btn projectplus-btn--ghost" data-pp-modal-close>
                    {{ __('Cancelar', 'projectplus') }}
                </button>
                <button type="submit" class="projectplus-btn">
                    {{ __('Criar projeto', 'projectplus') }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endif %}

<script id="pp-data" type="application/json">{{ {
    'states': states,
    'users': users,
    'current_user_id': current_user_id,
    'phases_by_type': phases_by_type,
    'can_team': can_team,
    'can_edit_project': can_edit_project,
    'desc_required': desc_required,
    'can_delete_tasks': can_delete_tasks,
    'can_delete_project': can_delete_project,
    'read_only': nav.client,
    'scope_mine': filter_scope == 'mine',
    'tasks_mine': tasks_mine,
    'managed_projects': managed_projects,
    'templates': templates,
    'today': today
}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>

<script src="{{ plugin_web_dir }}/js/projectplus.js"></script>
<script>
    // Espera o DOMContentLoaded: os JS do hook do GLPI (i18n.js à frente)
    // executam ANTES desse evento, então o primeiro desenho já sai com o
    // dicionário de tradução carregado (correção de 31/07/2026).
    (function () {
        function ppBoot() {
            if (window.ProjectPlus && typeof window.ProjectPlus.initDashboard === 'function') {
                window.ProjectPlus.initDashboard();
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', ppBoot);
        } else {
            ppBoot();
        }
    })();
</script>

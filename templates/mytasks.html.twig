{# ProjectPlus — "Minhas tarefas" (Etapa 3, Bloco 1) #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/projectplus.css">

<div class="projectplus-app" id="projectplus-mytasks"
     data-ajax-url="{{ plugin_web_dir }}/ajax/dashboard_data.php"
     data-task-url="{{ plugin_web_dir }}/ajax/task.php"
     data-comment-url="{{ plugin_web_dir }}/ajax/comment.php"
     data-dep-url="{{ plugin_web_dir }}/ajax/taskdep.php"
     data-alerts-url="{{ plugin_web_dir }}/ajax/alerts.php"
     data-initial-project="{{ initial_project }}"
     data-initial-task="{{ initial_task }}"
     data-csrf="{{ csrf_token }}">

    {# Bloco N-1a: barra superior no lugar da coluna lateral #}
    {% include '@projectplus/_topbar.html.twig' with {pp_active: 'minhas', pp_title: __('Minhas tarefas', 'projectplus'), pp_sub: __('Suas tarefas em todos os projetos', 'projectplus')} %}

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="projectplus-main">

        <div class="projectplus-header">
            <div class="pp-mt-filters">
                <label class="pp-mt-toggle">
                    <input type="checkbox" id="pp-mt-done" data-pp-fav-ui="done"{{ initial_done ? ' checked' : '' }}>
                    {{ __('Mostrar tarefas concluídas', 'projectplus') }}
                </label>
                {# Filtros de TIPO e de PROJETO (Bloco C, 30/09/2026). Tipo:
                   mesma lista da Visão geral. Projeto: opções montadas pelo JS
                   a partir do payload (projetos em que o usuário tem tarefa),
                   restritas ao tipo escolhido. Os dois recortam lista E KPIs,
                   no cliente — sem mexer em escopo. Não são <label>: o
                   combobox de busca põe um input ao lado do select escondido. #}
                {# Bloco F-2a: na Visão do cliente os dois filtros ficam ocultos
                   (o select de Projeto continua no DOM: o link de projeto
                   ?project=ID ainda recorta a lista) #}
                {% if type_options is not empty and not nav.client %}
                <div class="pp-mt-project">
                    <span class="pp-mt-project__label">{{ __('Tipo', 'projectplus') }}</span>
                    <select id="pp-mt-type" class="pp-mt-type" data-pp-fav-ui="type" title="{{ __('Tipo de projeto', 'projectplus') }}">
                        <option value="">{{ __('Todos os tipos', 'projectplus') }}</option>
                        {% for t in type_options %}
                        <option value="{{ t.id }}"{{ initial_type is not empty and initial_type == t.id ~ '' ? ' selected' : '' }}>{{ t.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                {% endif %}
                <div class="pp-mt-project"{% if nav.client %} hidden{% endif %}>
                    <span class="pp-mt-project__label">{{ __('Projeto', 'projectplus') }}</span>
                    <select id="pp-mt-project" class="pp-search" data-pp-fav-ui="project">
                        <option value="0">{{ __('Todos os projetos', 'projectplus') }}</option>
                    </select>
                </div>
            </div>
            <div class="projectplus-actions">
                {% include '@projectplus/_favorite.html.twig' %}
                {# Sino de alertas — mesma estrutura da Visão geral; o
                   endpoint já devolve só os alertas do usuário logado
                   (tarefas em que está na equipe / projetos que gerencia) #}
                {% if nav.alerts %}
                <div class="pp-bell-wrap">
                    <button type="button" id="pp-bell" class="pp-bell" title="{{ __('Alertas', 'projectplus') }}">
                        <i class="ti ti-bell"></i><span class="pp-bell__badge" hidden>0</span>
                    </button>
                    <div id="pp-bell-panel" class="pp-bell__panel" hidden>
                        <div class="pp-bell__head">
                            <strong>{{ __('Alertas', 'projectplus') }}</strong>
                            <button type="button" class="pp-bell__readall">{{ __('Marcar todas como lidas', 'projectplus') }}</button>
                        </div>
                        <ul class="pp-bell__list"></ul>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {# ================= KPIs pessoais ================= #}
        <div class="projectplus-kpis">
            <div class="projectplus-kpi">
                <span class="projectplus-kpi__icon projectplus-kpi__icon--blue"><i class="ti ti-list-check"></i></span>
                <div>
                    <span class="projectplus-kpi__value" id="pp-mt-kpi-open">—</span>
                    <span class="projectplus-kpi__label">{{ __('Tarefas abertas', 'projectplus') }}</span>
                    <span class="projectplus-kpi__sub">{{ __('Atribuídas a você', 'projectplus') }}</span>
                </div>
            </div>
            <div class="projectplus-kpi">
                <span class="projectplus-kpi__icon projectplus-kpi__icon--teal"><i class="ti ti-alert-circle"></i></span>
                <div>
                    <span class="projectplus-kpi__value" id="pp-mt-kpi-overdue">—</span>
                    <span class="projectplus-kpi__label">{{ __('Atrasadas', 'projectplus') }}</span>
                    <span class="projectplus-kpi__sub">{{ __('Prazo final vencido', 'projectplus') }}</span>
                </div>
            </div>
            <div class="projectplus-kpi">
                <span class="projectplus-kpi__icon projectplus-kpi__icon--amber"><i class="ti ti-calendar-off"></i></span>
                <div>
                    <span class="projectplus-kpi__value" id="pp-mt-kpi-nodates">—</span>
                    <span class="projectplus-kpi__label">{{ __('Sem datas', 'projectplus') }}</span>
                    <span class="projectplus-kpi__sub">{{ __('Planejamento a corrigir', 'projectplus') }}</span>
                </div>
            </div>
            <div class="projectplus-kpi">
                <span class="projectplus-kpi__icon projectplus-kpi__icon--green"><i class="ti ti-circle-check"></i></span>
                <div>
                    <span class="projectplus-kpi__value" id="pp-mt-kpi-done">—</span>
                    <span class="projectplus-kpi__label">{{ __('Concluídas', 'projectplus') }}</span>
                    <span class="projectplus-kpi__sub">{{ __('Total histórico', 'projectplus') }}</span>
                </div>
            </div>
        </div>

        {# ================= Grupos por projeto (renderizados pelo JS) ================= #}
        <div id="pp-mt-groups">
            <div class="projectplus-card"><p class="projectplus-muted">{{ __('Carregando suas tarefas…', 'projectplus') }}</p></div>
        </div>
    </div>
</div>

<script id="pp-data" type="application/json">{{ {
    'states': states,
    'users': users,
    'current_user_id': current_user_id,
    'can_team': can_team,
    'can_delete_tasks': can_delete_tasks
}|json_encode|raw }}</script>

<script src="{{ plugin_web_dir }}/js/projectplus.js"></script>
<script>
    // Espera o DOMContentLoaded: os JS do hook do GLPI (i18n.js à frente)
    // executam ANTES desse evento, então o primeiro desenho já sai com o
    // dicionário de tradução carregado (correção de 31/07/2026).
    (function () {
        function ppBoot() {
            if (window.ProjectPlus && typeof window.ProjectPlus.initMyTasks === 'function') {
                window.ProjectPlus.initMyTasks();
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', ppBoot);
        } else {
            ppBoot();
        }
    })();
</script>

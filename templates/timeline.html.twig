{# ProjectPlus — "Timeline" (Etapa 3, bloco final): Gantt somente-leitura #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/projectplus.css">

<div class="projectplus-app" id="projectplus-timeline">

    {# Bloco N-1a: barra superior no lugar da coluna lateral #}
    {% include '@projectplus/_topbar.html.twig' with {pp_active: 'timeline', pp_title: __('Timeline', 'projectplus'), pp_sub: __('Linha do tempo de projetos e tarefas', 'projectplus')} %}

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="projectplus-main">

        {# ===== Bloco N-4: faixa de filtros no padrão das outras telas =====
           Mesmos ids/classes que o timeline.js usa (pp-tl-zoom__btn, pp-tl-today,
           pp-tl-done, pp-tl-search); só a aparência mudou. #}
        <div class="pp-filterbar">
            {% include '@projectplus/_favorite.html.twig' %}
            <span class="pp-filterbar__sep"></span>
            {# Bloco F-2a: escondido na Visão do cliente #}
            {% if not nav.client %}
            <form method="get" class="pp-filterbar__form" action="{{ plugin_web_dir }}/front/timeline.php">
                {% if type_scope %}<input type="hidden" name="scope" value="{{ type_scope }}">{% endif %}
                <span class="pp-filterbar__label">{{ __('Tipo', 'projectplus') }}</span>
                <select name="type" onchange="this.form.submit()"
                        title="{{ __('Mostrar apenas os projetos deste tipo', 'projectplus') }}">
                    <option value="">{{ __('Todos os tipos', 'projectplus') }}</option>
                    {% for t in type_options %}
                    <option value="{{ t.id }}" {{ (type_selected is not null and type_selected == t.id) ? 'selected' : '' }}>{{ t.name }}</option>
                    {% endfor %}
                </select>
                <noscript>
                    <button type="submit" class="projectplus-btn projectplus-btn--ghost">{{ __('Abrir', 'projectplus') }}</button>
                </noscript>
            </form>
            {% endif %}
            <div class="pp-seg pp-seg--links pp-tl-zoom" role="group" aria-label="{{ __('Zoom', 'projectplus') }}">
                <button type="button" class="pp-seg__btn pp-tl-zoom__btn" data-pp-zoom="day">{{ __('Dia', 'projectplus') }}</button>
                <button type="button" class="pp-seg__btn pp-tl-zoom__btn pp-tl-zoom__btn--active" data-pp-zoom="week">{{ __('Semana', 'projectplus') }}</button>
                <button type="button" class="pp-seg__btn pp-tl-zoom__btn" data-pp-zoom="month">{{ __('Mês', 'projectplus') }}</button>
            </div>
            <button type="button" class="pp-filterbar__btn" id="pp-tl-today">
                <i class="ti ti-calendar-event"></i>{{ __('Hoje', 'projectplus') }}
            </button>
            {% if scope_can_expand and not nav.client %}
            <div class="pp-seg pp-seg--links" role="group" aria-label="{{ __('Escopo', 'projectplus') }}">
                {% if scope_is_expanded %}
                <span class="pp-seg__btn pp-seg__btn--active" aria-current="true">{{ __('Todos', 'projectplus') }}</span>
                <a class="pp-seg__btn" href="{{ scope_toggle_url }}" title="{{ __('Voltar ao escopo pessoal', 'projectplus') }}">{{ __('Só os meus', 'projectplus') }}</a>
                {% else %}
                <a class="pp-seg__btn" href="{{ scope_toggle_url }}" title="{{ __('Incluir todos os projetos que você pode ver', 'projectplus') }}">{{ __('Todos', 'projectplus') }}</a>
                <span class="pp-seg__btn pp-seg__btn--active" aria-current="true">{{ __('Só os meus', 'projectplus') }}</span>
                {% endif %}
            </div>
            {% endif %}
            <span class="pp-filterbar__spacer"></span>
            <input type="search" class="pp-filterbar__search" id="pp-tl-search"
                   placeholder="{{ __('Buscar projeto ou tarefa…', 'projectplus') }}"
                   aria-label="{{ __('Buscar projeto ou tarefa', 'projectplus') }}">
            <label class="pp-switch">
                <input type="checkbox" id="pp-tl-done">
                <span class="pp-switch__track" aria-hidden="true"></span>
                {{ __('Mostrar tarefas concluídas', 'projectplus') }}
            </label>
        </div>

        <div class="projectplus-card projectplus-card--full pp-tl-card">
            {% if only_mine %}
                <p class="projectplus-muted" style="padding: 0 16px 8px; margin: 0;">
                    <i class="ti ti-user-check"></i>
                    {{ __('Exibindo somente as suas tarefas.', 'projectplus') }}
                </p>
            {% endif %}
            <div class="pp-tl-legend">
                <span><i class="pp-tl-legend__bar"></i>{{ __('Período planejado (preenchimento = progresso)', 'projectplus') }}</span>
                <span><i class="pp-tl-legend__ms"></i>{{ __('Marco (só uma data planejada)', 'projectplus') }}</span>
                <span><i class="pp-tl-legend__today"></i>{{ __('Hoje', 'projectplus') }}</span>
                <span><i class="pp-tl-legend__overdue"></i>{{ __('Em atraso', 'projectplus') }}</span>
            </div>
            <div id="pp-tl" class="pp-tl-scroll">
                <p class="projectplus-muted">{{ __('Carregando a timeline…', 'projectplus') }}</p>
            </div>
        </div>
    </div>
</div>

<script id="pp-tl-data" type="application/json">{{ timeline|json_encode|raw }}</script>

<script src="{{ plugin_web_dir }}/js/timeline.js"></script>
<script>
    // Espera o DOMContentLoaded: os JS do hook do GLPI (i18n.js à frente)
    // executam ANTES desse evento, então o primeiro desenho já sai com o
    // dicionário de tradução carregado (correção de 31/07/2026).
    (function () {
        function ppBoot() {
            if (window.ProjectPlusTimeline && typeof window.ProjectPlusTimeline.init === 'function') {
                window.ProjectPlusTimeline.init();
            }
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', ppBoot);
        } else {
            ppBoot();
        }
    })();
</script>

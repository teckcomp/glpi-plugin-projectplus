{# ProjectPlus — editor visual de modelos (Etapa 4, itens 1 e 2) #}

<link rel="stylesheet" href="{{ plugin_web_dir }}/css/projectplus.css">

<div class="projectplus-app" id="projectplus-tpleditor"
     data-form-url="{{ plugin_web_dir }}/front/projecttemplate.form.php">

    {# ================= COLUNA ESQUERDA: título + sidebar ================= #}
    <div class="projectplus-left">
        <div class="projectplus-pagetitle">
            <h2>{{ __('Projetos', 'projectplus') }}</h2>
            <span>{{ is_new ? __('Novo modelo', 'projectplus') : __('Editar modelo', 'projectplus') }}</span>
        </div>
        <nav class="projectplus-sidebar">
            <ul>
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/dashboard.php"><i class="ti ti-layout-dashboard"></i>{{ __('Visão geral', 'projectplus') }}</a>
                </li>
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/mytasks.php"><i class="ti ti-user-check"></i>{{ __('Minhas tarefas', 'projectplus') }}</a>
                </li>
                <li class="projectplus-sidebar__item">
                    <a href="{{ glpi_root }}/front/project.form.php?showglobalkanban=1"><i class="ti ti-layout-kanban"></i>{{ __('Kanban global', 'projectplus') }}</a>
                </li>
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/timeline.php"><i class="ti ti-stopwatch"></i>{{ __('Timeline', 'projectplus') }}</a>
                </li>
                {% if can_templates %}
                <li class="projectplus-sidebar__item projectplus-sidebar__item--active">
                    <a href="{{ plugin_web_dir }}/front/projecttemplates.php"><i class="ti ti-clipboard-list"></i>{{ __('Modelos', 'projectplus') }}</a>
                </li>
                {% endif %}
                <li class="projectplus-sidebar__item projectplus-sidebar__item--soon">
                    <span><i class="ti ti-calendar"></i>{{ __('Calendário', 'projectplus') }}</span><em>{{ __('em breve', 'projectplus') }}</em>
                </li>
                <li class="projectplus-sidebar__item projectplus-sidebar__item--soon">
                    <span><i class="ti ti-users"></i>{{ __('Recursos', 'projectplus') }}</span><em>{{ __('em breve', 'projectplus') }}</em>
                </li>
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/costs.php"><i class="ti ti-coin"></i>{{ __('Orçamento', 'projectplus') }}</a>
                </li>
                <li class="projectplus-sidebar__item projectplus-sidebar__item--soon">
                    <span><i class="ti ti-report-analytics"></i>{{ __('Relatórios', 'projectplus') }}</span><em>{{ __('em breve', 'projectplus') }}</em>
                </li>
                <li class="projectplus-sidebar__item">
                    <a href="{{ plugin_web_dir }}/front/config.form.php"><i class="ti ti-settings"></i>{{ __('Configurações', 'projectplus') }}</a>
                </li>
            </ul>
        </nav>
    </div>

    {# ================= ÁREA PRINCIPAL ================= #}
    <div class="projectplus-main">

        <div class="projectplus-header">
            <div class="projectplus-pagetitle" style="padding:0">
                <h2 style="font-size:1.25rem;color:#16323f;margin:0">
                    {{ is_new ? __('Novo modelo de projeto', 'projectplus') : __('Editar modelo de projeto', 'projectplus') }}
                </h2>
                <span class="projectplus-subtitle">{{ __('Monte a árvore de tarefas e subprojetos. Os prazos são em dias a partir do início do projeto.', 'projectplus') }}</span>
            </div>
            <div class="projectplus-actions">
                <a class="projectplus-btn projectplus-btn--ghost" href="{{ plugin_web_dir }}/front/projecttemplates.php">
                    {{ __('Voltar', 'projectplus') }}
                </a>
            </div>
        </div>

        <form id="pp-tpl-form" method="post" action="{{ plugin_web_dir }}/front/projecttemplate.form.php">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="savejson" value="1">
            <input type="hidden" name="id" value="{{ tpl_id }}">
            <input type="hidden" name="structure" id="pp-tpl-structure-out" value="">

            <div class="projectplus-card">
                <div class="projectplus-form" style="display:grid">
                    <label class="projectplus-form__full">
                        {{ __('Nome do modelo', 'projectplus') }} *
                        <input type="text" name="name" id="pp-tpl-name" required maxlength="255" value="{{ tpl_name }}">
                    </label>
                    <label class="projectplus-form__full">
                        {{ __('Comentário', 'projectplus') }}
                        <textarea name="comment" rows="2">{{ tpl_comment }}</textarea>
                    </label>
                </div>
            </div>

            <div class="projectplus-card">
                <h3>{{ __('Projeto (aplicado ao criar)', 'projectplus') }}</h3>
                <p class="projectplus-subtitle" style="margin:0 0 8px">{{ __('Estado, tipo, gestor e orçamento que o projeto raiz recebe ao ser criado a partir do modelo.', 'projectplus') }}</p>
                <div id="pp-tpl-projectmeta" class="pp-tpl-projmeta"></div>
            </div>

            <div class="projectplus-card" id="pp-tpl-tree">
                <h3>{{ __('Tarefas do projeto', 'projectplus') }}</h3>
                <div id="pp-tpl-roottasks" class="pp-tpl-list"></div>
                <button type="button" class="projectplus-btn projectplus-btn--ghost pp-tpl-add" data-add-roottask>
                    + {{ __('Adicionar tarefa', 'projectplus') }}
                </button>

                <h3 style="margin-top:22px">{{ __('Subprojetos', 'projectplus') }}</h3>
                <div id="pp-tpl-rootsubs" class="pp-tpl-list"></div>
                <button type="button" class="projectplus-btn projectplus-btn--ghost pp-tpl-add" data-add-rootsub>
                    + {{ __('Adicionar subprojeto', 'projectplus') }}
                </button>
            </div>

            <div class="projectplus-form__footer" style="border:0;padding:0;margin-top:6px">
                <a class="projectplus-btn projectplus-btn--ghost" href="{{ plugin_web_dir }}/front/projecttemplates.php">
                    {{ __('Cancelar', 'projectplus') }}
                </a>
                <button type="submit" class="projectplus-btn">
                    {{ is_new ? __('Criar modelo', 'projectplus') : __('Salvar alterações', 'projectplus') }}
                </button>
            </div>
        </form>
    </div>
</div>

<script id="pp-tpl-structure" type="application/json">{{ structure_json|raw }}</script>
<script id="pp-tpl-refdata" type="application/json">{{ refdata_json|raw }}</script>

<script src="{{ plugin_web_dir }}/js/projectplus.js"></script>
<script>
    if (window.ProjectPlus && typeof window.ProjectPlus.initTemplateEditor === 'function') {
        window.ProjectPlus.initTemplateEditor();
    }
</script>
